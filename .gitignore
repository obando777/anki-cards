# Build output — derived from decks/, never edit or commit
build/
*.apkg

# Generated TTS clips — derived, regenerable, ~25 MB
.audio-cache/

# Fetched/generated card images — derived; the manifest is what's versioned
.image-cache/

# Local credentials — never commit
.env
.env.*
!.env.example

# Source material you drop in to make cards from — not tracked
raw_input/

# Agent session scratch
mytasks/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# macOS
.DS_Store

# Editors
.idea/
.vscode/
mytasks/
# Capturas y scratch temporal
.tmp/
